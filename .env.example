# ── Balamonis Studio — the one secret you need ──────────────────────────────
# Your Anthropic API key powers every campaign the engine generates.
# Get one (free to create) at: https://console.anthropic.com/settings/keys
#
# Local dev:  copy this file to .env.local and paste your key below.
# Netlify:    add ANTHROPIC_API_KEY under Site configuration → Environment variables.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — your live URL, used for SEO/social link previews.
# On Netlify this is provided automatically; you usually don't need to set it.
# NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app
